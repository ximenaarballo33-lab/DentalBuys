rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuario unico autenticado. Si luego quieres restringir por email exacto,
    // cambiamos esta condicion por request.auth.token.email == "tu@email.com".
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
